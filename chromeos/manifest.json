{
  "manifest_version": 3,
  "name": "Meltype-FLASH for ChromeOS",
  "description": "日本語と英語を自動判定するChromeOS向け日本語入力。",
  "version": "1.0.10",
  "version_name": "1.0.10",
  "minimum_chrome_version": "119",
  "permissions": [
    "input",
    "storage",
    "offscreen"
  ],
  "optional_permissions": [
    "tabs",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "input_components": [
    {
      "name": "Meltype-FLASH（日本語配列）",
      "id": "meltype-rust",
      "language": [
        "ja"
      ],
      "layouts": [
        "jp::jpn"
      ],
      "options_page": "options.html"
    },
    {
      "name": "Meltype-FLASH（US配列）",
      "id": "meltype-rust-us",
      "language": [
        "ja"
      ],
      "layouts": [
        "us::eng"
      ],
      "options_page": "options.html"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Meltype-FLASHの設定"
  },
  "optional_host_permissions": [
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*"
  ]
}
