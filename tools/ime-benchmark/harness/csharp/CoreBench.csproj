<Project Sdk="Microsoft.NET.Sdk">
  <!-- 1万文コアベンチ用の一時プロジェクト。対象リポジトリの src/Meltype.Core を参照するだけで、
       リポジトリのソースは書き換えない (このファイルはリポジトリの外に置く)。
       __CORE_PROJECT__ は core_bench_runner.py が対象の Meltype.Core.csproj の絶対パスに置き換える。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CoreBench</AssemblyName>
    <RootNamespace>CoreBench</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzers>false</RunAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8602;CS8604;CS8618;CS8625;CS8632;CS0168;CS0219;CS0436;CS0618</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="__CORE_PROJECT__" />
  </ItemGroup>
</Project>
